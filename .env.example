# Copiez ce fichier en .env et renseignez vos valeurs (.env n'est jamais versionné).

# GEMINI_API_KEY: Required for Gemini AI API calls (coach vocal Live).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="https://kro-nova.com"

# MONGODB_URI: Connection string for MongoDB Atlas or a local MongoDB instance.
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="MY_MONGODB_URI"

# MONGODB_DB: Database name used by Cadence (default: cadence).
MONGODB_DB="cadence"

# PORT: HTTP port of the server (default: 3000).
PORT=3000

# SIGNUP_CODE: optionnel — code d'invitation exigé pour créer un compte (à partager avec l'équipe).
SIGNUP_CODE=""

# ALLOWED_EMAIL_DOMAINS: optionnel — domaines e-mail autorisés à s'inscrire, séparés par des virgules.
# e.g. ALLOWED_EMAIL_DOMAINS="kamer-center.net,exemple.com"
ALLOWED_EMAIL_DOMAINS=""

# GOOGLE_CLIENT_ID: optionnel — ID client OAuth « Application Web » pour Google Agenda / Tasks.
GOOGLE_CLIENT_ID=""
